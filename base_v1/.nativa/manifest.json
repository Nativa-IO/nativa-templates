{
  "version": 2,
  "runtime": "docker-compose",
  "services": {
    "backend": {
      "path": "backend",
      "compose_service": "backend",
      "health": {
        "type": "http",
        "port": 8000,
        "path": "/health",
        "method": "GET",
        "expect_status": [
          200
        ],
        "timeout_ms": 2000,
        "interval_ms": 3000,
        "retries": 3,
        "start_period_ms": 120000
      },
      "sandbox": {
        "cwd": "/workspace/backend",
        "env": {
          "PATH": "/opt/venv/bin:${PATH}"
        }
      },
      "commands": {
        "install": "pip install --ignore-requires-python -e .",
        "add": "uv add {args}",
        "remove": "uv remove {args}",
        "migrate": "alembic upgrade head",
        "migration.create": "alembic revision --autogenerate -m {args}",
        "migration.status": "alembic current",
        "test": "pytest -q",
        "start": "uvicorn app.main:app --host 0.0.0.0 --port 8000"
      }
    },
    "frontend": {
      "path": "frontend",
      "compose_service": "frontend",
      "health": {
        "type": "http",
        "port": 3000,
        "path": "/",
        "method": "GET",
        "expect_status": [
          200
        ],
        "timeout_ms": 2000,
        "interval_ms": 3000,
        "retries": 3,
        "start_period_ms": 60000
      },
      "sandbox": {
        "cwd": "/workspace/frontend"
      },
      "commands": {
        "install": "npm ci",
        "add": "npm install {args}",
        "remove": "npm uninstall {args}",
        "build": "npm run build",
        "test": "npm test",
        "start": "npm run dev"
      }
    }
  }
}
